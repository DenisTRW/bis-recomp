# Original ROM and everything extracted from it - NEVER commit
orig/*
!orig/.gitkeep
!orig/README.md
*.nds
*.srl
extract/
assets/

# Build output
build/
*.o
*.elf
*.map

# Ghidra project and settings (contain original code)
/ghidra/

# Local tools (compiler, dsd, objdiff, ...)
tools/*
!tools/.gitkeep
!tools/README.md

# Python / Editor
__pycache__/
*.pyc
.vscode/
.idea/

# Launcher build output
/game.json

# Local screenshots rendered from your own ROM (shown in the launcher) - never commit
screenshots/
/BISLauncher.exe

# Save files of the PC port (--save) - player data, never commit
/saves/
*.sav
